rules_version = '2';

// FinSight Firestore security rules.
//
// Model:
//   users/{uid}                        private profile, owner only
//   users/{uid}/transactions/{id}      private, owner only
//   users/{uid}/budgets/{id}           private, owner only
//   users/{uid}/goals/{id}             private, owner only
//   users/{uid}/learning_progress/{id} private, owner only
//   users/{uid}/lesson_cards/{key}      private, owner only
//   rooms/{code}                       Bubble Room market, host writes, all read
//   rooms/{code}/players/{pid}         player creates once, host updates
//   rooms/{code}/orders/{id}           players append, host reads
//
// Course content (learning paths, glossary) is static and ships with the app
// in data/courseContent.ts, so it has no collection here at all.
//
// Anything not matched below is denied. New collections must be added here
// explicitly before the client can touch them.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── Field validation ─────────────────────────────────────────────────
    // On update, request.resource.data is the full merged document, so these
    // hold for partial updates too.

    function validTransaction() {
      let d = request.resource.data;
      return d.amount is number
          && d.amount >= 0
          && d.type in ['debit', 'credit']
          && d.category is string
          && d.merchant is string
          && d.date is string;
    }

    function validBudget() {
      let d = request.resource.data;
      return d.category is string
          && d.monthlyLimit is number
          && d.monthlyLimit >= 0
          && d.currentSpend is number
          && d.month is string;
    }

    function validGoal() {
      let d = request.resource.data;
      return d.title is string
          && d.title.size() > 0
          && d.title.size() <= 100
          && d.targetAmount is number
          && d.targetAmount > 0
          && d.savedAmount is number
          && d.savedAmount >= 0;
    }

    function validProgress() {
      let d = request.resource.data;
      return d.completedModules is list
          && d.percentage is number
          && d.percentage >= 0
          && d.percentage <= 100
          && d.badgeEarned is bool;
    }

    function validReviewCard() {
      let d = request.resource.data;
      return d.box is int
          && d.box >= 1
          && d.box <= 5
          && d.dueDate is string
          && d.question is string
          && d.answer is string;
    }

    // ── Private user data ────────────────────────────────────────────────

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /transactions/{transactionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validTransaction();
      }

      match /budgets/{budgetId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validBudget();
      }

      match /goals/{goalId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validGoal();
      }

      match /learning_progress/{pathId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validProgress();
      }

      // Spaced repetition schedule, one document per flashcard.
      match /flashcard_reviews/{cardId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validReviewCard();
      }

      // Lesson mistake bank, one document per answered card. Same Leitner
      // shape as the flashcards, without the question text: the card lives
      // in the bundle and the key resolves it.
      match /lesson_cards/{cardKey} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.box is int
          && request.resource.data.box >= 1
          && request.resource.data.box <= 5
          && request.resource.data.dueDate is string
          && request.resource.data.lessonId is string
          && request.resource.data.trackId is string;
      }

      // Merchant-to-category fixes the user made by hand, from Tidy Up.
      match /category_corrections/{transactionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.merchant is string
          && request.resource.data.category is string;
      }
    }

    // ── Bubble Room ──────────────────────────────────────────────────────
    //
    // A three-minute classroom market. The host is a signed-in app user and
    // is the only one who writes shared state: the room, and every player's
    // holdings. Players join from a browser with no account, so their two
    // writes are allowed without auth and validated by shape instead: they
    // may create their own player document with the starting balances, and
    // append buy or sell orders. Everything here is play money.

    function isRoomHost(code) {
      return isSignedIn()
        && get(/databases/$(database)/documents/rooms/$(code)).data.hostUid == request.auth.uid;
    }

    function roomOpen(code) {
      return get(/databases/$(database)/documents/rooms/$(code)).data.status in ['lobby', 'live'];
    }

    match /rooms/{code} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby';
      allow update, delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;

      match /players/{pid} {
        allow read: if true;
        allow create: if roomOpen(code)
          && request.resource.data.keys().hasOnly(['name', 'cash', 'tokens', 'buys', 'sells', 'spent', 'earned', 'topBuy', 'joinedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 16
          && request.resource.data.cash == 800
          && request.resource.data.tokens == 2
          && request.resource.data.buys == 0
          && request.resource.data.sells == 0
          && request.resource.data.spent == 0
          && request.resource.data.earned == 0
          && request.resource.data.topBuy == 0;
        allow update, delete: if isRoomHost(code);
      }

      match /orders/{orderId} {
        allow create: if roomOpen(code)
          && request.resource.data.keys().hasOnly(['pid', 'side', 'at'])
          && request.resource.data.pid is string
          && request.resource.data.side in ['buy', 'sell']
          && request.resource.data.at is number;
        allow read, delete: if isRoomHost(code);
      }
    }

    // ── Default deny ─────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
