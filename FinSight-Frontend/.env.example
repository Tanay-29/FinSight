# Firebase Configuration Template
# Copy this file to .env and fill in your actual values
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Flask backend URL (your laptop's local IP + port)
EXPO_PUBLIC_BACKEND_URL=http://YOUR_LOCAL_IP:5000

# Google sign-in. The Web client ID is in Firebase console > Authentication >
# Sign-in method > Google > Web SDK configuration. The iOS client ID comes
# from the iOS app registered in the same project (GoogleService-Info.plist,
# CLIENT_ID). Android needs no ID, only the app's SHA-1 added in Firebase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
